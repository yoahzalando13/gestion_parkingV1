<%- include('../partials/header', { pageTitle: 'Nouvelle place de parking' }) %>
<div class="app">
    <%- include('../partials/sidebar', { activeMenu: 'spaces' }) %>

    <main class="content">
        <div class="page-head">
            <div>
                <h1>Créer une place de parking</h1>
                <p>Définir le numéro, la zone, le niveau et le type d'attribution.</p>
            </div>
            <a class="btn" href="/spaces">Retour aux places</a>
        </div>

        <%- include('../partials/alerts') %>

        <div class="card" style="max-width:600px;">
            <form action="/spaces" method="post">
                <div class="form-grid">
                    <div class="field">
                        <label for="number">Numéro de place</label>
                        <input type="text" id="number" name="number" placeholder="Ex: A13, B11..." required autofocus>
                    </div>
                    <div class="field">
                        <label for="zone">Zone</label>
                        <input type="text" id="zone" name="zone" placeholder="Ex: A, B, C..." required maxlength="10">
                    </div>
                    <div class="field">
                        <label for="level">Niveau</label>
                        <input type="number" id="level" name="level" value="0" required>
                    </div>
                    <div class="field">
                        <label for="type">Type de place</label>
                        <select id="type" name="type" required>
                            <option value="STANDARD">Standard</option>
                            <option value="PMR">PMR (Personne à mobilité réduite)</option>
                            <option value="VIP">VIP</option>
                            <option value="ABONNE">Abonné dédié</option>
                        </select>
                    </div>
                </div>
                <div class="form-actions" style="margin-top:20px;">
                    <button class="btn primary" type="submit">Créer la place</button>
                    <a class="btn" href="/spaces">Annuler</a>
                </div>
            </form>
        </div>
    </main>
</div>
</body>
</html>
