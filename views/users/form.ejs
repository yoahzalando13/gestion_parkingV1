<%- include('../partials/header', { pageTitle: 'Nouvel utilisateur' }) %>
<div class="app">
    <%- include('../partials/sidebar', { activeMenu: 'users' }) %>

    <main class="content">
        <div class="page-head">
            <div>
                <h1>Créer un utilisateur</h1>
                <p>Création d'un compte avec rôle et profil d'accès.</p>
            </div>
            <a class="btn" href="/users">Retour</a>
        </div>

        <%- include('../partials/alerts') %>

        <div class="card" style="max-width:650px;">
            <form action="/users" method="post">
                <div class="form-grid">
                    <div class="field">
                        <label for="username">Identifiant de connexion</label>
                        <input type="text" id="username" name="username" required autofocus>
                    </div>
                    <div class="field">
                        <label for="password">Mot de passe</label>
                        <input type="password" id="password" name="password" required>
                    </div>
                    <div class="field">
                        <label for="firstName">Prénom</label>
                        <input type="text" id="firstName" name="firstName" required>
                    </div>
                    <div class="field">
                        <label for="lastName">Nom</label>
                        <input type="text" id="lastName" name="lastName" required>
                    </div>
                    <div class="field">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="field">
                        <label for="phone">Téléphone</label>
                        <input type="text" id="phone" name="phone" placeholder="+261 ...">
                    </div>
                    <div class="field">
                        <label for="role">Rôle</label>
                        <select id="role" name="role" required>
                            <option value="USER">Utilisateur (Client)</option>
                            <option value="OPERATOR">Opérateur</option>
                            <option value="MANAGER">Gestionnaire</option>
                            <option value="ADMIN">Administrateur</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="category">Catégorie usager</label>
                        <select id="category" name="category" required>
                            <option value="STANDARD">Standard</option>
                            <option value="VIP">VIP</option>
                            <option value="PMR">PMR (Mobilité réduite)</option>
                            <option value="ABONNE">Abonné</option>
                        </select>
                    </div>
                </div>
                <div class="form-actions" style="margin-top:20px;">
                    <button class="btn primary" type="submit">Créer l'utilisateur</button>
                    <a class="btn" href="/users">Annuler</a>
                </div>
            </form>
        </div>
    </main>
</div>
</body>
</html>
